---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f5ed" />
    <meta name="description" content="This page could not be found. Return to The Marginalia." />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      href={`${base}favicon-32x32.png`}
      type="image/png"
      sizes="32x32"
    />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>Page Not Found — The Marginalia</title>
  </head>

  <body>
    <main class="page">
      <div class="topline">
        <span>A personal literary journal</span>
        <span class="topline-center">Essays · Fiction · Reflections</span>
        <span>Established 2025</span>
      </div>

      <header>
        <a class="wordmark" href={base}>The <em>Marginalia</em><span>.</span></a>
        <p class="tagline">Notes on philosophy, life, and the things in between.</p>
      </header>

      <section class="not-found" aria-labelledby="error-title">
        <p class="eyebrow">A small detour</p>
        <div class="error-number" aria-hidden="true">404<span>.</span></div>
        <h1 id="error-title">This page seems to have wandered off.</h1>
        <p class="message">
          The page you're looking for may have moved, been renamed, or never
          existed. The thought, perhaps, is elsewhere.
        </p>
        <a class="home-link" href={base}>
          Return to the journal <span aria-hidden="true">↗</span>
        </a>
      </section>

      <footer>
        <a href={base}>The <em>Marginalia.</em></a>
        <span>Written slowly, published occasionally.</span>
        <span>© {new Date().getFullYear()} Hemang Jindal</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #f8f5ed;
    color: #24221f;
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid #a64d36;
    outline-offset: 5px;
  }

  .page {
    width: min(100% - 84px, 1120px);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
  }

  .topline {
    min-height: 34px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    border-bottom: 1px dashed #bdb7aa;
    color: #81786c;
    font-size: 8px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .topline-center {
    color: #a64d36;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 10px;
    font-style: italic;
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
  }

  .topline > :last-child {
    text-align: right;
  }

  header {
    padding: 30px 0 27px;
    border-bottom: 1px dashed #bdb7aa;
  }

  .wordmark {
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(35px, 5vw, 53px);
    letter-spacing: -2.7px;
  }

  .wordmark em,
  .wordmark span {
    color: #a64d36;
    font-weight: 400;
  }

  .tagline {
    margin: 7px 0 0;
    color: #71695e;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 11px;
    font-style: italic;
  }

  .not-found {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 85px 20px 110px;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    color: #a64d36;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .error-number {
    margin: 17px 0 7px;
    color: #a64d36;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(100px, 19vw, 190px);
    font-style: italic;
    line-height: 1;
    letter-spacing: -12px;
  }

  .error-number span {
    color: #24221f;
  }

  h1 {
    max-width: 600px;
    margin: 18px 0 13px;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(25px, 4vw, 38px);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -1.2px;
  }

  .message {
    max-width: 440px;
    margin: 0;
    color: #71695e;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 12px;
    line-height: 2;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    margin-top: 29px;
    padding: 12px 18px;
    border-radius: 30px;
    background: #24221f;
    color: #fffdf7;
    font-size: 10px;
    font-weight: 600;
    transition: background 180ms ease, transform 180ms ease;
  }

  .home-link:hover {
    transform: translateY(-2px);
    background: #a64d36;
  }

  footer {
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid #dcd6ca;
    color: #81786c;
    font-size: 9px;
  }

  footer a {
    color: #24221f;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 15px;
  }

  footer em {
    color: #a64d36;
    font-weight: 400;
  }

  @media (max-width: 600px) {
    .page {
      width: calc(100% - 42px);
    }

    .topline {
      min-height: 29px;
      font-size: 6px;
      letter-spacing: 0.7px;
    }

    .topline-center {
      font-size: 7px;
    }

    header {
      padding: 25px 0 22px;
    }

    .tagline {
      font-size: 9px;
    }

    .not-found {
      padding: 75px 5px 90px;
    }

    .error-number {
      letter-spacing: -7px;
    }

    h1 {
      font-size: 26px;
    }

    .message {
      font-size: 11px;
    }

    footer {
      min-height: 90px;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 10px;
      padding: 18px 0;
    }

    footer span {
      font-size: 8px;
    }

    footer span:nth-child(2) {
      order: 3;
      width: 100%;
    }
  }
</style>
