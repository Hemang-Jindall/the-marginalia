        </a>
      </footer>
    </div>
  </body>
</html>

<script>
  // Cinematic first-visit opening. The intro is shown once per browser tab.
  const introCurtain = document.querySelector<HTMLElement>("#intro-curtain");
  const introSkip = document.querySelector<HTMLButtonElement>("#intro-skip");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let introDismissed = false;

  const dismissIntro = () => {
    if (!introCurtain || introDismissed) return;
    introDismissed = true;
    introCurtain.classList.add("intro-leaving");
    document.documentElement.classList.remove("intro-active");
    window.setTimeout(() => introCurtain.remove(), reduceMotion ? 0 : 900);
  };

  if (introCurtain) {
    let alreadySeen = false;
    try {
      alreadySeen = sessionStorage.getItem("marginalia-intro-seen") === "1";
      sessionStorage.setItem("marginalia-intro-seen", "1");
    } catch {
      alreadySeen = false;
    }

    if (alreadySeen || reduceMotion) {
      introCurtain.remove();
    } else {
      document.documentElement.classList.add("intro-active");
      introCurtain.classList.add("intro-ready");
      window.setTimeout(dismissIntro, 2300);
      introSkip?.addEventListener("click", dismissIntro);
      introCurtain.addEventListener("click", (event) => {
        if (event.target === introCurtain) dismissIntro();
      });
    }
  }

  // Scroll progress drives the pinned opening composition.
  const openingScene = document.querySelector<HTMLElement>(".opening-scene");
  const openingCopy = document.querySelector<HTMLElement>(".opening-copy");
  const openingArt = document.querySelector<HTMLElement>(".opening-art");

  if (openingScene && !reduceMotion) {
    let ticking = false;

    const updateOpeningProgress = () => {
      const bounds = openingScene.getBoundingClientRect();
      const scrollableDistance = Math.max(
        1,
        openingScene.offsetHeight - window.innerHeight,
      );
      const progress = Math.min(
        1,
        Math.max(0, -bounds.top / scrollableDistance),
      );
      openingScene.style.setProperty("--scroll-progress", progress.toFixed(4));

      const darkPaper = [33, 31, 28];
      const lightPaper = [238, 233, 223];
      const blendedPaper = darkPaper.map((start, index) =>
        Math.round(start + (lightPaper[index] - start) * progress),
      );
      openingScene.style.setProperty(
        "--scene-background",
        `rgb(${blendedPaper.join(" ")})`,
      );

      if (openingCopy) {
        openingCopy.style.setProperty("--copy-shift", `${progress * -170}px`);
      }
      if (openingArt) {
        openingArt.style.setProperty("--art-shift", "0px");
        openingArt.style.setProperty("--art-turn", `${progress * 68}deg`);
      }

      ticking = false;
    };

    const requestOpeningUpdate = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateOpeningProgress);
        ticking = true;
      }
    };

    window.addEventListener("scroll", requestOpeningUpdate, { passive: true });
    window.addEventListener("resize", requestOpeningUpdate);
    updateOpeningProgress();
  }
</script>

<script>
  const searchInput =
    document.querySelector<HTMLInputElement>("#archive-search");

  const clearSearchButton =
    document.querySelector<HTMLButtonElement>("#clear-search");

  const resetFiltersButton =
    document.querySelector<HTMLButtonElement>("#reset-filters");

  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".filter-button"),
  );

  const entries = Array.from(
    document.querySelectorAll<HTMLElement>(".archive-entry"),
  );

  const yearGroups = Array.from(
    document.querySelectorAll<HTMLElement>(".year-group"),
  );

  const noResults = document.querySelector<HTMLElement>("#no-results");

  const visibleCount = document.querySelector<HTMLElement>("#visible-count");

  const countLabel = document.querySelector<HTMLElement>("#count-label");

  let activeCategory = "all";

  function applyFilters() {
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    let visibleTotal = 0;

    entries.forEach((entry) => {
      const category = entry.dataset.category ?? "";
      const searchableText = entry.dataset.search ?? "";

      const matchesCategory =
        activeCategory === "all" || category === activeCategory;

      const matchesSearch =
        query.length === 0 || searchableText.includes(query);

      const visible = matchesCategory && matchesSearch;

      entry.hidden = !visible;

      if (visible) {
        visibleTotal += 1;
      }
    });

    yearGroups.forEach((group) => {
      const groupHasVisibleEntries = Array.from(
        group.querySelectorAll<HTMLElement>(".archive-entry"),
      ).some((entry) => !entry.hidden);

      group.hidden = !groupHasVisibleEntries;

      const yearCount = group.querySelector<HTMLElement>(".year-count");

      if (yearCount) {
        const visibleInYear = Array.from(
          group.querySelectorAll<HTMLElement>(".archive-entry"),
        ).filter((entry) => !entry.hidden).length;

        yearCount.textContent = `${visibleInYear} ${visibleInYear === 1 ? "piece" : "pieces"}`;
      }
    });

    if (visibleCount) {
      visibleCount.textContent = String(visibleTotal);
    }

    if (countLabel) {
      countLabel.textContent = visibleTotal === 1 ? "piece" : "pieces";
    }

    if (noResults) {
      noResults.hidden = visibleTotal !== 0;
    }

    if (clearSearchButton) {
      clearSearchButton.hidden = query.length === 0;
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.dataset.filter ?? "all";

      filterButtons.forEach((otherButton) => {
        const isActive = otherButton === button;

        otherButton.classList.toggle("active", isActive);
        otherButton.setAttribute("aria-pressed", String(isActive));
      });

      applyFilters();
    });
  });

  searchInput?.addEventListener("input", applyFilters);

  clearSearchButton?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
      searchInput.focus();
    }

    applyFilters();
  });

  resetFiltersButton?.addEventListener("click", () => {
    activeCategory = "all";

    if (searchInput) {
      searchInput.value = "";
    }

    filterButtons.forEach((button) => {
      const isActive = button.dataset.filter === "all";

      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });

    applyFilters();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && searchInput) {
      searchInput.value = "";
      applyFilters();
      searchInput.blur();
    }
  });
</script>

<script>
  const motionSections = document.querySelectorAll<HTMLElement>(
    ".opening-scene, .featured-section, .archive-heading, .archive-entry, .archive-footnote, .about-section",
  );

  if ("IntersectionObserver" in window) {
    document.documentElement.classList.add("has-motion");

    // Give each archive entry a small stagger, while keeping long archives snappy.
    document
      .querySelectorAll<HTMLElement>(".archive-entry")
      .forEach((entry, index) => {
        entry.style.setProperty(
          "--entry-reveal-delay",
          `${Math.min(index % 7, 6) * 65}ms`,
        );
      });

    const revealObserver = new IntersectionObserver(
      (items, observer) => {
        items.forEach((item) => {
          if (item.isIntersecting) {
            item.target.classList.add("is-visible");
            observer.unobserve(item.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -35px 0px" },
    );

    motionSections.forEach((section) => revealObserver.observe(section));
  }

  const openingArt = document.querySelector<HTMLElement>(".opening-art");
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");

  if (openingArt && canHover.matches) {
    openingArt.addEventListener("pointermove", (event) => {
      const bounds = openingArt.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      openingArt.style.setProperty("--pointer-x", `${x * 12}px`);
      openingArt.style.setProperty("--pointer-y", `${y * 12}px`);
    });

    openingArt.addEventListener("pointerleave", () => {
      openingArt.style.setProperty("--pointer-x", "0px");
      openingArt.style.setProperty("--pointer-y", "0px");
    });
  }
</script>

<script>
  const compassOptions = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".compass-option"),
  );
  const compassInitial =
    document.querySelector<HTMLElement>("#compass-initial");
  const compassTitle = document.querySelector<HTMLElement>("#compass-title");
  const compassDescription = document.querySelector<HTMLElement>(
    "#compass-description",
  );
  const compassLink =
    document.querySelector<HTMLAnchorElement>("#compass-link");
  const compassLinkLabel = document.querySelector<HTMLElement>(
    "#compass-link-label",
  );

  const readingPaths: Record<
    string,
    { initial: string; description: string; label: string; href: string }
  > = {
    Philosophy: {
      initial: "P",
      description: "Questions of meaning, ethics, and how we ought to live.",
      label: "Explore philosophy",
      href: "#archive",
    },
    Fiction: {
      initial: "F",
      description: "Imagined worlds that test what it means to be human.",
      label: "Enter fiction",
      href: compassLink?.dataset.fictionUrl ?? "#archive",
    },
    Reflections: {
      initial: "R",
      description: "Notes on ordinary life, attention, memory, and change.",
      label: "Read reflections",
      href: "#archive",
    },
  };

  compassOptions.forEach((option) => {
    option.addEventListener("click", () => {
      const category = option.dataset.path ?? "Philosophy";
      const path = readingPaths[category];
      if (!path) return;

      compassOptions.forEach((item) => {
        const active = item === option;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });

      if (compassInitial) compassInitial.textContent = path.initial;
      if (compassTitle) compassTitle.textContent = category;
      if (compassDescription) compassDescription.textContent = path.description;
      if (compassLink) compassLink.href = path.href;
      if (compassLinkLabel) compassLinkLabel.textContent = path.label;
    });
  });

  compassLink?.addEventListener("click", (event) => {
    const category = compassOptions.find((option) =>
      option.classList.contains("is-active"),
    )?.dataset.path;

    if (category === "Fiction") return;

    const filter = document.querySelector<HTMLButtonElement>(
      `.filter-button[data-filter="${category}"]`,
    );
    if (filter) {
      event.preventDefault();
      filter.click();
      document
        .querySelector("#archive")
        ?.scrollIntoView({ behavior: "smooth" });
    }
  });
</script>

<script>
  // A soft, cursor-driven reveal confined to the closing About section.
  const aboutReveal = document.querySelector<HTMLElement>(".about-section");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
  const motionPreference = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  if (aboutReveal && finePointer.matches && !motionPreference.matches) {
    let targetX = 50;
    let targetY = 50;
    let currentX = 50;
    let currentY = 50;
    let frame = 0;

    const animateReveal = () => {
      currentX += (targetX - currentX) * 0.13;
      currentY += (targetY - currentY) * 0.13;
      aboutReveal.style.setProperty("--reveal-x", `${currentX}%`);
      aboutReveal.style.setProperty("--reveal-y", `${currentY}%`);

      if (
        Math.abs(targetX - currentX) > 0.08 ||
        Math.abs(targetY - currentY) > 0.08
      ) {
        frame = window.requestAnimationFrame(animateReveal);
      } else {
        frame = 0;
      }
    };

    aboutReveal.addEventListener("pointerenter", () => {
      aboutReveal.classList.add("reveal-active");
    });

    aboutReveal.addEventListener("pointermove", (event) => {
      const bounds = aboutReveal.getBoundingClientRect();
      targetX = ((event.clientX - bounds.left) / bounds.width) * 100;
      targetY = ((event.clientY - bounds.top) / bounds.height) * 100;
      if (!frame) frame = window.requestAnimationFrame(animateReveal);
    });

    aboutReveal.addEventListener("pointerleave", () => {
      aboutReveal.classList.remove("reveal-active");
      targetX = 50;
      targetY = 50;
      if (!frame) frame = window.requestAnimationFrame(animateReveal);
    });
  }
</script>

