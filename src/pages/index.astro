---
import { getCollection } from "astro:content";

const essays = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pinnedEssays = essays.filter((essay) => essay.data.pinned);

if (pinnedEssays.length > 1) {
  throw new Error(
    `Multiple posts are pinned (${pinnedEssays.map((essay) => essay.id).join(", ")}). Please set pinned: true on only one post.`,
  );
}

const featured = pinnedEssays[0] ?? essays[0];
const isPinned = pinnedEssays.length === 1;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const postUrl = (id: string) => `${base.replace(/\/$/, "")}/posts/${id}/`;

const categories = [
  ...new Set(essays.map((essay) => essay.data.category)),
].sort((a, b) => a.localeCompare(b));

const groupedEssays = essays.reduce(
  (groups, essay) => {
    const year = essay.data.pubDate.getUTCFullYear();

    if (!groups[year]) {
      groups[year] = [];
    }

    groups[year].push(essay);
    return groups;
  },
  {} as Record<number, typeof essays>,
);

const years = Object.keys(groupedEssays)
  .map(Number)
  .sort((a, b) => b - a);

const getReadingTime = (content: string) =>
  Math.max(1, Math.ceil(content.trim().split(/\s+/).length / 220));

const featuredReadingTime = featured ? getReadingTime(featured.body ?? "") : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script>
      // Start the homepage at the top, even if the browser restored an old #archive URL.
      if (window.location.hash === "#archive") {
        window.history.replaceState(
          null,
          "",
          window.location.pathname + window.location.search,
        );
        window.scrollTo(0, 0);
      }
    </script>

    <meta
      name="description"
      content="The Marginalia is an independent journal of essays on philosophy, fiction, ethics, and the everyday questions that deserve a second look."
    />

    <meta name="theme-color" content="#f8f5ed" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      href={`${base}favicon-32x32.png`}
      type="image/png"
      sizes="32x32"
    />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <title>The Marginalia — Essays, Fiction & Reflections</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="intro-curtain" id="intro-curtain">
      <div class="intro-curtain-inner">
        <span class="intro-overline">An independent literary journal</span>
        <div class="intro-wordmark">The <em>Marginalia.</em></div>
        <span class="intro-rule"></span>
        <span class="intro-enter">Ideas begin in the margins</span>
      </div>
      <button class="intro-skip" id="intro-skip" type="button"
        >Skip intro <span>↗</span></button
      >
    </div>
    <div class="page">
      <main>
        <!-- IMMERSIVE INTRO -->
        <section class="opening-scene" aria-labelledby="opening-title">
          <div class="opening-stage">
            <div class="opening-scroll-type" aria-hidden="true">
              <span class="scroll-type-line scroll-type-one"
                >THE WORLD IS WIDER</span
              >
              <span class="scroll-type-line scroll-type-two"
                >THAN THE WORDS WE HAVE</span
              >
            </div>
            <div class="opening-topline">
              <div class="opening-publication">
                <a class="opening-publication-name" href={base}>
                  The <em>Marginalia.</em>
                </a>
                <span class="opening-publication-tagline">
                  Notes on philosophy, life, and the things in between.
                </span>
              </div>
              <div class="opening-imprint" aria-label="Publication details">
                <span>An independent journal</span>
                <strong>Volume <em>I</em></strong>
                <span>2025 — {new Date().getFullYear()}</span>
              </div>
            </div>

            <div class="opening-composition">
              <div class="opening-copy">
                <p class="opening-kicker">
                  <span></span> A journal of ideas and imagination
                </p>
                <h1 id="opening-title">
                  The world,<br />in the <em>margins.</em>
                </h1>
                <div class="opening-bottomline">
                  <p>
                    Essays, fiction, and observations on being human.
                    <span>Read something. Question everything.</span>
                  </p>
                  <a
                    class="opening-explore"
                    href="#archive"
                    aria-label="Explore the journal"
                  >
                    <span>Explore the journal</span><span
                      class="explore-arrow"
                      aria-hidden="true">↓</span
                    >
                  </a>
                </div>
              </div>

              <div class="opening-art reading-compass" id="reading-compass">
                <span class="compass-brand" aria-hidden="true">
                  <svg
                    class="marginalia-mark"
                    viewBox="0 0 150 150"
                    role="presentation"
                  >
                    <circle cx="75" cy="75" r="67.5"></circle>
                    <text x="75" y="101" text-anchor="middle">M</text>
                    <circle class="mark-dot" cx="113" cy="101" r="5"></circle>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </section>

        <!-- FEATURED ARTICLE -->

        {
          featured && (
            <section class="featured-section" aria-labelledby="featured-title">
              <div class="section-eyebrow">
                <span class="eyebrow-dot" />
                {isPinned
                  ? "Pinned from the journal"
                  : "The latest from the journal"}
              </div>

              <div class="featured-grid">
                <div class="featured-content">
                  <div class="featured-meta">
                    <span class="pill">{featured.data.category}</span>

                    <time datetime={featured.data.pubDate.toISOString()}>
                      {featured.data.pubDate.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                        timeZone: "UTC",
                      })}
                    </time>
                    <span class="meta-separator" aria-hidden="true">
                      /
                    </span>
                    <span>{featuredReadingTime} min read</span>
                  </div>

                  <h1 id="featured-title">
                    <a href={postUrl(featured.id)}>{featured.data.title}</a>
                  </h1>

                  <p class="featured-description">
                    {featured.data.description}
                  </p>

                  <div class="featured-bottom">
                    <a class="read-button" href={postUrl(featured.id)}>
                      Read the essay
                      <span aria-hidden="true">↗</span>
                    </a>

                    <span class="featured-label">
                      {isPinned
                        ? "Selected by the editor"
                        : "Journal entry no. 01"}
                    </span>
                  </div>
                </div>

                <aside class="featured-aside" aria-label="Journal statistics">
                  <div class="aside-eyebrow">Ideas in the margins</div>

                  <div class="piece-count">{essays.length}</div>

                  <div class="aside-divider" />

                  <p class="aside-caption">
                    Philosophy · Fiction · The human condition
                  </p>

                  <span class="aside-vertical">The Marginalia / Vol. I</span>
                </aside>
              </div>
            </section>
          )
        }

        <!-- ARCHIVE -->

        <section class="archive-section" id="archive">
          <div class="archive-heading">
            <div>
              <div class="section-eyebrow">
                <span class="eyebrow-dot"></span>
                From the notebook
              </div>

              <h2>Writing by year.</h2>
            </div>

            <div class="archive-total">
              <span id="visible-count">{essays.length}</span>
              <span id="count-label">
                {essays.length === 1 ? "piece" : "pieces"}
              </span>
              <span class="count-separator">·</span>
              <span>All writing</span>
            </div>
          </div>

          <!-- SEARCH -->

          <div class="archive-tools">
            <label class="search-box">
              <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.8" cy="10.8" r="6.8"></circle>
                <path d="m16 16 4.2 4.2"></path>
              </svg>

              <input
                id="archive-search"
                type="search"
                placeholder="Search the journal..."
                aria-label="Search essays by title, description, or category"
                autocomplete="off"
              />
            </label>

            <button id="clear-search" class="clear-search" type="button" hidden>
              Clear search
            </button>
          </div>

          <!-- CATEGORY FILTERS -->

          <div class="filter-area">
            <span class="filter-label">Browse by subject</span>

            <div
              class="category-filters"
              id="category-filters"
              role="group"
              aria-label="Filter writing by category"
            >
              <button
                class="filter-button active"
                type="button"
                data-filter="all"
                aria-pressed="true"
              >
                All writing
                <span class="filter-count">{essays.length}</span>
              </button>

              {
                categories.map((category) => {
                  const count = essays.filter(
                    (essay) => essay.data.category === category,
                  ).length;

                  return (
                    <button
                      class="filter-button"
                      type="button"
                      data-filter={category}
                      aria-pressed="false"
                    >
                      {category}
                      <span class="filter-count">{count}</span>
                    </button>
                  );
                })
              }
            </div>
          </div>

          <!-- ARTICLE LIST -->

          <div id="archive-results" aria-live="polite">
            {
              years.map((year) => (
                <section
                  class="year-group"
                  data-year-group={year}
                  aria-labelledby={`year-${year}`}
                >
                  <div class="year-heading">
                    <h3 id={`year-${year}`}>{year}</h3>

                    <span class="year-count">
                      {groupedEssays[year].length}
                      {groupedEssays[year].length === 1 ? " piece" : " pieces"}
                    </span>
                  </div>

                  <div class="year-essays">
                    {groupedEssays[year].map((essay) => (
                      <article
                        class="archive-entry"
                        data-category={essay.data.category}
                        data-year={year}
                        data-search={`${essay.data.title} ${essay.data.description} ${essay.data.category} ${year}`.toLowerCase()}
                      >
                        <span class="entry-number" aria-hidden="true">
                          {String(
                            groupedEssays[year].indexOf(essay) + 1,
                          ).padStart(2, "0")}
                        </span>

                        <div class="entry-main">
                          <h4>
                            <a href={postUrl(essay.id)}>{essay.data.title}</a>
                          </h4>

                          <p class="entry-description">
                            {essay.data.description}
                          </p>

                          <span class="entry-category">
                            {essay.data.category}
                          </span>
                        </div>

                        <time
                          class="entry-date"
                          datetime={essay.data.pubDate.toISOString()}
                        >
                          {essay.data.pubDate.toLocaleDateString("en-US", {
                            month: "short",
                            day: "numeric",
                            year: "numeric",
                            timeZone: "UTC",
                          })}
                        </time>
                      </article>
                    ))}
                  </div>
                </section>
              ))
            }

            <div class="no-results" id="no-results" hidden>
              <span class="no-results-mark">∅</span>

              <h3>No essays found.</h3>

              <p>
                Nothing in the journal matches your search. Try another phrase
