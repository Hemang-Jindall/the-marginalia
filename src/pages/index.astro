                  d="M-80 370 C110 290 155 130 325 150 S535 405 720 320 890 90 1075 150 1205 275 1290 195"
                ></path>
                <path
                  d="M-80 390 C120 310 170 155 340 175 S550 425 735 345 905 115 1090 175 1220 295 1290 215"
                ></path>
                <path
                  d="M-80 250 C70 190 125 20 290 35 S490 285 665 205 850 -5 1035 45 1180 165 1290 90"
                ></path>
                <path
                  d="M-80 225 C60 165 115 -5 280 10 S480 260 650 180 835 -30 1020 20 1170 140 1290 65"
                ></path>
                <path
                  d="M-80 205 C50 145 105 -25 270 -10 S470 240 635 160 820 -50 1005 0 1160 115 1290 40"
                ></path>
                <path
                  d="M-80 180 C40 120 95 -50 260 -35 S460 215 620 135 805 -75 990 -25 1150 90 1290 15"
                ></path>
                <path
                  d="M-80 410 C150 340 205 200 365 220 S565 450 755 370 930 145 1110 205 1235 320 1290 245"
                ></path>
                <path
                  d="M-80 145 C20 90 75 -80 245 -65 S445 185 605 105 790 -105 975 -55 1135 65 1290 -10"
                ></path>
                <path
                  d="M-80 300 C90 225 135 55 300 75 S505 330 680 245 860 20 1045 75 1185 200 1290 125"
                ></path>
              </g>
            </svg>
          </div>
          <div class="about-heading">
            <div class="section-eyebrow">
              <span class="eyebrow-dot"></span>
              A note on the project
            </div>

            <h2>
              A place for the questions that{" "}
              <em>stay with us.</em>
            </h2>
          </div>

          <p class="about-copy">
            The Marginalia is an independent journal by Hemang Jindal,
