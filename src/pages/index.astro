  /* CINEMATIC INTRO + SCROLL CHOREOGRAPHY */
  :global(html.intro-active),
  :global(html.intro-active body) {
    overflow: hidden;
  }

  .intro-curtain {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #211f1c;
    color: #f2eee5;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 850ms cubic-bezier(0.76, 0, 0.24, 1),
      visibility 850ms;
  }
  .intro-curtain.intro-ready {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .intro-curtain::before,
  .intro-curtain::after {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    border: 1px solid rgba(196, 122, 96, 0.18);
    border-radius: 50%;
    content: "";
    transform: scale(0.3);
    opacity: 0;
  }

  .intro-curtain::before {
    animation: intro-ring 2.1s 0.05s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .intro-curtain::after {
    width: 48vmax;
    height: 48vmax;
    animation: intro-ring 2.1s 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  .intro-curtain-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px;
    text-align: center;
  }

  .intro-overline,
  .intro-enter {
    color: #bdb3a5;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0;
  }

  .intro-overline {
    animation: intro-rise 0.7s 0.15s ease forwards;
  }
  .intro-wordmark {
    margin: 24px 0 20px;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(45px, 9vw, 112px);
    letter-spacing: -0.075em;
    line-height: 1.15;
    clip-path: inset(0 50% 0 50%);
    animation: intro-unmask 1.05s 0.35s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .intro-wordmark em {
    color: #c47a60;
    font-weight: 400;
  }
  .intro-rule {
    width: 0;
    height: 1px;
    background: #a96a53;
    animation: intro-rule 850ms 1s ease forwards;
  }
  .intro-enter {
    margin-top: 18px;
