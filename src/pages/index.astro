  .nav-links {
    display: flex;
    align-items: center;
    gap: 27px;
  }

  .nav-links a,
  .nav-motto {
    color: #625b51;
    font-size: 9px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .nav-links a:hover {
    color: #a64d36;
  }

  .nav-motto {
    color: #8a8073;
    font-size: 8px;
    letter-spacing: 1px;
  }

  /* SHARED LABELS */

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #a64d36;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2px;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: #a64d36;
  }

  /* FEATURED ARTICLE */

  .featured-section {
    padding: 52px 0 70px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(230px, 0.8fr);
    align-items: stretch;
    gap: 70px;
    margin-top: 20px;
  }

  .featured-content {
    min-width: 0;
    padding-right: 0;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 13px;
    color: #777064;
    font-size: 9px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
  }

  .pill {
    display: inline-block;
    padding: 6px 10px;
    border: 1px solid #d9bcae;
    border-radius: 30px;
    color: #a64d36;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .featured-content h1 {
    margin: 17px 0 15px;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(42px, 5.5vw, 72px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -3.5px;
  }

  .featured-content h1 a {
    transition: color 180ms ease;
  }

  .featured-content h1 a:hover {
    color: #a64d36;
  }

  .featured-description {
    max-width: 620px;
    margin: 0;
    color: #655e54;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 14px;
    font-style: italic;
    line-height: 1.9;
  }

  .featured-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 23px;
    padding-top: 18px;
    border-top: 1px dashed #c5bfb3;
  }

  .read-button {
    min-height: 39px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 17px;
    border-radius: 30px;
    background: #24221f;
    color: #fffdf7;
    font-size: 10px;
    font-weight: 600;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .read-button:hover {
    transform: translateY(-2px);
    background: #a64d36;
  }

  .read-button span {
    font-size: 14px;
  }

  .featured-label {
    color: #8b8174;
    font-size: 8px;
    letter-spacing: 1.7px;
    text-align: right;
    text-transform: uppercase;
  }

  .featured-aside {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 25px 35px;
    border-left: 1px solid #ddd6c9;
    text-align: center;
  }

  .aside-eyebrow {
    color: #8b8174;
    font-size: 8px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .piece-count {
    margin: 8px 0 4px;
    color: #a64d36;
    font-family: "DM Sans", sans-serif;
    font-size: clamp(100px, 12vw, 165px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -8px;
  }

  .aside-divider {
    width: 100%;
    max-width: 210px;
    margin: 19px 0 13px;
    border-top: 1px solid #cfc6b8;
  }

  .aside-caption {
    margin: 0;
    color: #8b8174;
    font-size: 8px;
    letter-spacing: 1px;
    line-height: 1.8;
    text-transform: uppercase;
  }

  .aside-vertical {
    position: absolute;
    top: 50%;
    right: -19px;
    color: #a49a8b;
    font-size: 7px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: translateY(-50%);
  }

  /* ARCHIVE */

  .archive-section {
    padding: 24px 0 75px;
    border-top: 1px solid #4d473e;
  }

  .archive-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 27px;
  }

  .archive-heading h2,
  .fiction-copy h2,
  .about-heading h2 {
    margin: 11px 0 0;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -1.7px;
  }

  .archive-total {
    display: flex;
    align-items: center;
    gap: 5px;
    padding-bottom: 7px;
    color: #8a8073;
    font-size: 8px;
    letter-spacing: 1.1px;
    text-align: right;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .count-separator {
    padding: 0 2px;
  }

  /* SEARCH */

  .archive-tools {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 23px;
  }

  .search-box {
    width: 100%;
    min-height: 47px;
    display: flex;
    align-items: center;
