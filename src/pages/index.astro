  }
  .entry-main h4 a:hover {
    color: #a64d36;
  }

  .about-section {
    padding-top: 100px;
    padding-bottom: 110px;
  }
  .about-heading h2 {
    font-size: clamp(42px, 6vw, 78px);
  }
  footer {
    border-top: 1px solid #d4ccbf;
  }

  .has-motion .opening-scene,
  .has-motion .featured-section,
  .has-motion .archive-heading,
  .has-motion .about-section {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 750ms ease,
      transform 750ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .has-motion .opening-scene.is-visible,
  .has-motion .featured-section.is-visible,
  .has-motion .archive-heading.is-visible,
  .has-motion .about-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Archive entries arrive individually, with a gentle stagger. */
  .has-motion .archive-entry,
  .has-motion .archive-footnote {
    opacity: 0;
    transform: translateY(22px);
    filter: blur(3px);
    transition:
      opacity 650ms ease,
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 650ms ease;
    transition-delay: var(--entry-reveal-delay, 0ms);
  }

  .has-motion .archive-entry.is-visible,
  .has-motion .archive-footnote.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* The closing note unfolds in two quiet beats. */
  .has-motion .about-heading,
  .has-motion .about-copy {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 800ms ease,
      transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .has-motion .about-copy {
    transition-delay: 150ms;
    transform: translateY(32px);
  }

  .has-motion .about-section.is-visible .about-heading,
  .has-motion .about-section.is-visible .about-copy {
    opacity: 1;
    transform: translateY(0);
  }

