            </div>
          </div>

          <p class="archive-footnote">Every piece, in its own time.</p>
        </section>

        <!-- ABOUT -->

        <section class="about-section" id="about">
          <div class="about-reveal-art" aria-hidden="true">
            <svg viewBox="0 0 1200 420" preserveAspectRatio="none">
              <g class="contour-lines">
