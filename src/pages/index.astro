        </section>
      </main>

      <!-- FOOTER -->

      <footer>
        <a class="footer-brand" href={base}>
          The <em>Marginalia.</em>
        </a>

        <span class="footer-note">
          Written slowly, published occasionally.
        </span>

        <span class="copyright">
