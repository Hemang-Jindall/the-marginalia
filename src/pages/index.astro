---
import { getCollection } from "astro:content";

const essays = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = essays[0];
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const postUrl = (id: string) =>
  `${base.replace(/\/$/, "")}/posts/${id}/`;

const categories = [
  ...new Set(essays.map((essay) => essay.data.category)),
].sort((a, b) => a.localeCompare(b));

const groupedEssays = essays.reduce(
  (groups, essay) => {
    const year = essay.data.pubDate.getUTCFullYear();

    if (!groups[year]) {
      groups[year] = [];
    }

    groups[year].push(essay);
    return groups;
  },
  {} as Record<number, typeof essays>,
);

const years = Object.keys(groupedEssays)
  .map(Number)
  .sort((a, b) => b - a);

const getReadingTime = (content: string) =>
  Math.max(1, Math.ceil(content.trim().split(/\s+/).length / 220));

const featuredReadingTime = featured
  ? getReadingTime(featured.body)
  : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="The Marginalia is an independent journal of essays on philosophy, fiction, ethics, and the everyday questions that deserve a second look."
    />

    <meta name="theme-color" content="#f8f5ed" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      href={`${base}favicon-32x32.png`}
      type="image/png"
      sizes="32x32"
    />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <title>The Marginalia — Essays, Fiction & Reflections</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="page">
      <!-- MASTHEAD -->

      <div class="topline">
        <span>A personal literary journal</span>
        <span class="topline-center">Essays · Fiction · Reflections</span>
        <span>Established 2025</span>
      </div>

      <header class="masthead">
        <div class="masthead-main">
          <a class="wordmark" href={base}>
            The <em>Marginalia</em><span class="wordmark-period">.</span>
          </a>
          <p class="tagline">
            Notes on philosophy, life, and the things in between.
          </p>
        </div>

        <div class="masthead-imprint" aria-label="Publication details">
          <span class="imprint-label">An independent journal</span>
          <span class="imprint-volume">Volume <em>I</em></span>
          <span class="imprint-years">2025 — {new Date().getFullYear()}</span>
        </div>
      </header>

      <nav class="navigation" aria-label="Main navigation">
        <div class="nav-links">
          <a href={`${base}#archive`}>Essays</a>
          <a href={`${base}fiction/`}>Fiction</a>
          <a href={`${base}#archive`}>Archive</a>
          <a href={`${base}about/`}>About</a>
        </div>

        <span class="nav-motto">Read slowly. Think freely.</span>
      </nav>

      <main>
        <!-- FEATURED ARTICLE -->

        {featured && (
          <section class="featured-section" aria-labelledby="featured-title">
            <div class="section-eyebrow">
              <span class="eyebrow-dot"></span>
              The latest from the journal
            </div>

            <div class="featured-grid">
              <div class="featured-content">
                <div class="featured-meta">
                  <span class="pill">{featured.data.category}</span>

                  <time datetime={featured.data.pubDate.toISOString()}>
                    {featured.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                      timeZone: "UTC",
                    })}
                  </time>
                  <span class="meta-separator" aria-hidden="true">/</span>
                  <span>{featuredReadingTime} min read</span>
                </div>

                <h1 id="featured-title">
                  <a href={postUrl(featured.id)}>
                    {featured.data.title}
                  </a>
                </h1>

                <p class="featured-description">
                  {featured.data.description}
                </p>

                <div class="featured-bottom">
                  <a class="read-button" href={postUrl(featured.id)}>
                    Read the essay
                    <span aria-hidden="true">↗</span>
                  </a>

                  <span class="featured-label">Journal entry no. 01</span>
                </div>
              </div>

              <aside class="featured-aside" aria-label="Journal statistics">
                <div class="aside-eyebrow">Ideas in the margins</div>

                <div class="piece-count">{essays.length}</div>

                <div class="aside-divider"></div>

                <p class="aside-caption">
                  Philosophy · Fiction · The human condition
                </p>

                <span class="aside-vertical">
                  The Marginalia / Vol. I
                </span>
              </aside>
            </div>
          </section>
        )}

        <!-- ARCHIVE -->

        <section class="archive-section" id="archive">
          <div class="archive-heading">
            <div>
              <div class="section-eyebrow">
                <span class="eyebrow-dot"></span>
                From the notebook
              </div>

              <h2>Writing by year.</h2>
            </div>

            <div class="archive-total">
              <span id="visible-count">{essays.length}</span>
              <span id="count-label">
                {essays.length === 1 ? "piece" : "pieces"}
              </span>
              <span class="count-separator">·</span>
              <span>All writing</span>
            </div>
          </div>

          <!-- SEARCH -->

          <div class="archive-tools">
            <label class="search-box">
              <span class="search-icon" aria-hidden="true">⌕</span>

              <input
                id="archive-search"
                type="search"
                placeholder="Search the journal..."
                aria-label="Search essays by title, description, or category"
                autocomplete="off"
              />

              <kbd>ESC</kbd>
            </label>

            <button
              id="clear-search"
              class="clear-search"
              type="button"
              hidden
            >
              Clear search
            </button>
          </div>

          <!-- CATEGORY FILTERS -->

          <div class="filter-area">
            <span class="filter-label">Browse by subject</span>

            <div
              class="category-filters"
              id="category-filters"
              role="group"
              aria-label="Filter writing by category"
            >
              <button
                class="filter-button active"
                type="button"
                data-filter="all"
                aria-pressed="true"
              >
                All writing
                <span class="filter-count">{essays.length}</span>
              </button>

              {
                categories.map((category) => {
                  const count = essays.filter(
                    (essay) => essay.data.category === category,
                  ).length;

                  return (
                    <button
                      class="filter-button"
                      type="button"
                      data-filter={category}
                      aria-pressed="false"
                    >
                      {category}
                      <span class="filter-count">{count}</span>
                    </button>
                  );
                })
              }
            </div>
          </div>

          <!-- ARTICLE LIST -->

          <div id="archive-results" aria-live="polite">
            {
              years.map((year) => (
                <section
                  class="year-group"
                  data-year-group={year}
                  aria-labelledby={`year-${year}`}
                >
                  <div class="year-heading">
                    <h3 id={`year-${year}`}>{year}</h3>

                    <span class="year-count">
                      {groupedEssays[year].length}
                      {groupedEssays[year].length === 1
                        ? " piece"
                        : " pieces"}
                    </span>
                  </div>

                  <div class="year-essays">
                    {groupedEssays[year].map((essay) => (
                      <article
                        class="archive-entry"
                        data-category={essay.data.category}
                        data-year={year}
                        data-search={`${essay.data.title} ${essay.data.description} ${essay.data.category} ${year}`.toLowerCase()}
                      >
                        <span class="entry-number" aria-hidden="true">
                          {String(
                            groupedEssays[year].indexOf(essay) + 1,
                          ).padStart(2, "0")}
                        </span>

                        <div class="entry-main">
                          <h4>
                            <a href={postUrl(essay.id)}>
                              {essay.data.title}
                            </a>
                          </h4>

                          <p class="entry-description">
                            {essay.data.description}
                          </p>

                          <span class="entry-category">
                            {essay.data.category}
                          </span>
                        </div>

                        <time
                          class="entry-date"
                          datetime={essay.data.pubDate.toISOString()}
                        >
                          {essay.data.pubDate.toLocaleDateString("en-US", {
                            month: "short",
                            day: "numeric",
                            year: "numeric",
                            timeZone: "UTC",
                          })}
                        </time>
                      </article>
                    ))}
                  </div>
                </section>
              ))
            }

            <div class="no-results" id="no-results" hidden>
              <span class="no-results-mark">∅</span>

              <h3>No essays found.</h3>

              <p>
                Nothing in the journal matches your search. Try another
                phrase or choose a different category.
              </p>

              <button id="reset-filters" type="button">
                Show all writing
              </button>
            </div>
          </div>

          <p class="archive-footnote">
            Every piece, in its own time.
          </p>
        </section>

        <!-- FICTION -->

        <section class="fiction-section" id="fiction">
          <div class="fiction-copy">
            <div class="section-eyebrow">
              <span class="eyebrow-dot"></span>
              Beyond the argument
            </div>

            <h2>
              Sometimes, a story asks what an argument cannot.
            </h2>

            <p>
              Fiction, imagined worlds, and questions about what makes us
              human.
            </p>

            <a class="text-link" href={`${base}fiction/`}>
              Explore fiction <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="fiction-mark" aria-hidden="true">
            F<span>.</span>
          </div>
        </section>

        <!-- ABOUT -->

        <section class="about-section" id="about">
          <div class="about-heading">
            <div class="section-eyebrow">
              <span class="eyebrow-dot"></span>
              A note on the project
            </div>

            <h2>
              A place for the questions that
              <em>stay with us.</em>
            </h2>
          </div>

          <p class="about-copy">
            The Marginalia is an independent journal by Hemang Jindal,
            collecting essays on philosophy, fiction, ethics, and the
            everyday questions that deserve a second look. Not answers
            handed down, but thoughts worked through in public.
          </p>
        </section>
      </main>

      <!-- FOOTER -->

      <footer>
        <a class="footer-brand" href={base}>
          The <em>Marginalia.</em>
        </a>

        <span class="footer-note">
          Written slowly, published occasionally.
        </span>

        <span class="copyright">
          © {new Date().getFullYear()} Hemang Jindal
        </span>

        <a class="rss-link" href={`${base}rss.xml`} aria-label="RSS feed">
          RSS <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </div>
  </body>
</html>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(
    "#archive-search",
  );

  const clearSearchButton = document.querySelector<HTMLButtonElement>(
    "#clear-search",
  );

  const resetFiltersButton = document.querySelector<HTMLButtonElement>(
    "#reset-filters",
  );

  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".filter-button"),
  );

  const entries = Array.from(
    document.querySelectorAll<HTMLElement>(".archive-entry"),
  );

  const yearGroups = Array.from(
    document.querySelectorAll<HTMLElement>(".year-group"),
  );

  const noResults = document.querySelector<HTMLElement>("#no-results");

  const visibleCount = document.querySelector<HTMLElement>("#visible-count");

  const countLabel = document.querySelector<HTMLElement>("#count-label");

  let activeCategory = "all";

  function applyFilters() {
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    let visibleTotal = 0;

    entries.forEach((entry) => {
      const category = entry.dataset.category ?? "";
      const searchableText = entry.dataset.search ?? "";

      const matchesCategory =
        activeCategory === "all" || category === activeCategory;

      const matchesSearch =
        query.length === 0 || searchableText.includes(query);

      const visible = matchesCategory && matchesSearch;

      entry.hidden = !visible;

      if (visible) {
        visibleTotal += 1;
      }
    });

    yearGroups.forEach((group) => {
      const groupHasVisibleEntries = Array.from(
        group.querySelectorAll<HTMLElement>(".archive-entry"),
      ).some((entry) => !entry.hidden);

      group.hidden = !groupHasVisibleEntries;

      const yearCount = group.querySelector<HTMLElement>(".year-count");

      if (yearCount) {
        const visibleInYear = Array.from(
          group.querySelectorAll<HTMLElement>(".archive-entry"),
        ).filter((entry) => !entry.hidden).length;

        yearCount.textContent =
          `${visibleInYear} ${visibleInYear === 1 ? "piece" : "pieces"}`;
      }
    });

    if (visibleCount) {
      visibleCount.textContent = String(visibleTotal);
    }

    if (countLabel) {
      countLabel.textContent = visibleTotal === 1 ? "piece" : "pieces";
    }

    if (noResults) {
      noResults.hidden = visibleTotal !== 0;
    }

    if (clearSearchButton) {
      clearSearchButton.hidden = query.length === 0;
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.dataset.filter ?? "all";

      filterButtons.forEach((otherButton) => {
        const isActive = otherButton === button;

        otherButton.classList.toggle("active", isActive);
        otherButton.setAttribute("aria-pressed", String(isActive));
      });

      applyFilters();
    });
  });

  searchInput?.addEventListener("input", applyFilters);

  clearSearchButton?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
      searchInput.focus();
    }

    applyFilters();
  });

  resetFiltersButton?.addEventListener("click", () => {
    activeCategory = "all";

    if (searchInput) {
      searchInput.value = "";
    }

    filterButtons.forEach((button) => {
      const isActive = button.dataset.filter === "all";

      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });

    applyFilters();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && searchInput) {
      searchInput.value = "";
      applyFilters();
      searchInput.blur();
    }
  });

</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 30px;
  }

  :global(body) {
    margin: 0;
    background: #f8f5ed;
    color: #24221f;
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(button),
  :global(input) {
    font: inherit;
  }

  :global(button:focus-visible),
  :global(input:focus-visible),
  a:focus-visible {
    outline: 2px solid #a64d36;
    outline-offset: 4px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    color: inherit;
  }

  [hidden] {
    display: none !important;
  }

  .page {
    width: min(100%, 1260px);
    margin: 0 auto;
    padding: 0 42px;
  }

  /* MASTHEAD */

  .topline {
    min-height: 29px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    border-bottom: 1px dashed #bdb7aa;
    color: #81786c;
    font-family: "DM Sans", sans-serif;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .topline-center {
    text-align: center;
    font-family: "Libre Baskerville", serif;
    font-size: 10px;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
  }

  .topline > :last-child {
    text-align: right;
  }

  .masthead {
    padding: 25px 0 27px;
    text-align: center;
  }

  .wordmark {
    display: inline-block;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(43px, 6.4vw, 77px);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -4.5px;
  }

  .wordmark em {
    color: #a64d36;
    font-weight: 400;
  }

  .tagline {
    margin: 4px 0 0;
    color: #665f55;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 13px;
    font-style: italic;
    line-height: 1.7;
  }

  .navigation {
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    border-top: 1px dashed #bdb7aa;
    border-bottom: 1px dashed #bdb7aa;
