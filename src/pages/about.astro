---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="The Marginalia is an independent journal of philosophy, fiction, and reflections."
    />

    <meta name="theme-color" content="#f8f5ed" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />

    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <title>About — The Marginalia</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div
      class="intro-curtain"
      id="intro-curtain"
      aria-label="Introducing The Marginalia"
    >
      <div class="intro-curtain-inner">
        <span class="intro-overline">An independent literary journal</span>

        <div class="intro-wordmark">The <em>Marginalia.</em></div>

        <span class="intro-rule"></span>

        <span class="intro-enter">Ideas begin in the margins</span>
      </div>

      <button class="intro-skip" id="intro-skip" type="button">
        Skip intro <span aria-hidden="true">↗</span>
      </button>
    </div>

    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href={base}>The <em>Marginalia.</em></a>

        <nav aria-label="Main navigation">
          <a href={`${base}#archive`}>Writing</a>
          <a href={`${base}about/`} aria-current="page">About</a>
        </nav>
      </header>

      <main>
        <section class="editor-story" aria-label="The editor and the journal">
          <div class="section-label">01 / The editor &amp; the journal</div>

          <div class="story-grid">
            <div class="story-copy">
              <h2>I'm <em>Hemang Jindal.</em></h2>

              <p>
                I'm the editor and the person behind The Marginalia. I started
                this journal as a place to give ideas room to breathe: to follow
                a question beyond its first answer, sit with an uncertainty, and
                work through a thought in writing.
              </p>

              <p>
                My interests tend to gather around philosophy, literature,
                ethics, and the ordinary details of being human. I enjoy the
                questions that don't resolve neatly, the arguments that make you
                reconsider what you thought you knew, and stories that leave
                something unsettled after the last page.
              </p>

              <p>
                I don't approach this as an authority handing down conclusions.
                I'm here as a reader and a writer, learning in public and trying
                to make the process of thinking a little more visible.
              </p>
            </div>

            <div class="journal-copy">
              <p class="eyebrow"><span></span> Why The Marginalia exists</p>

              <h2>A place for the questions that <em>stay with us.</em></h2>

              <p>
                The Marginalia is an independent journal collecting essays,
                fiction, and reflections on philosophy, ethics, and everyday
                life. It is built around a simple conviction: not every
                worthwhile thought needs to arrive as a finished answer.
              </p>

              <p>
                Some pieces begin with a book, some with a passing observation,
                and others with a question that refuses to leave. The aim is to
                give each one the attention it deserves—and to leave enough
                space in the margins for readers to bring their own thoughts.
              </p>

              <p class="journal-motto">
                Read slowly. <em>Question everything.</em>
              </p>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <a class="footer-brand" href={base}>The <em>Marginalia.</em></a>

        <span>Written slowly, published occasionally.</span>

        <span>© {new Date().getFullYear()} Hemang Jindal</span>

        <a href={`${base}rss.xml`}>RSS ↗</a>
      </footer>
    </div>
  </body>
</html>

<script>
  import Lenis from "lenis";

  // Keep the same restrained scroll feel across the journal.
  // Touch devices and reduced-motion users retain native scrolling.
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const hasFinePointer = window.matchMedia(
    "(hover: hover) and (pointer: fine)",
  ).matches;

  if (!prefersReducedMotion && hasFinePointer) {
    new Lenis({
      autoRaf: true,
      smoothWheel: true,
      lerp: 0.085,
      wheelMultiplier: 0.9,
      anchors: true,
    });
  }
</script>

<script>
  // The same restrained cinematic introduction used across the journal.

  const introCurtain = document.querySelector<HTMLElement>("#intro-curtain");

  const introSkip = document.querySelector<HTMLButtonElement>("#intro-skip");

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  let introDismissed = false;

  const dismissIntro = () => {
    if (!introCurtain || introDismissed) return;

    introDismissed = true;

    introCurtain.classList.add("intro-leaving");

    document.documentElement.classList.remove("intro-active");

    window.setTimeout(() => introCurtain.remove(), reduceMotion ? 0 : 900);
  };

  if (introCurtain) {
    let alreadySeen = false;

    try {
      alreadySeen =
        sessionStorage.getItem("marginalia-about-intro-seen") === "1";

      sessionStorage.setItem("marginalia-about-intro-seen", "1");
    } catch {
      alreadySeen = false;
    }

    if (alreadySeen || reduceMotion) {
      introCurtain.remove();
    } else {
      document.documentElement.classList.add("intro-active");

      introCurtain.classList.add("intro-ready");

      window.setTimeout(dismissIntro, 2450);

      introSkip?.addEventListener("click", dismissIntro);

      introCurtain.addEventListener("click", (event) => {
        if (event.target === introCurtain) dismissIntro();
      });
    }
  }

  // Reveal editorial sections as they enter the viewport.

  if (!reduceMotion && "IntersectionObserver" in window) {
    const revealTargets =
      document.querySelectorAll<HTMLElement>(".editor-story");

    revealTargets.forEach((element) => element.classList.add("will-reveal"));

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");

            observer.unobserve(entry.target);
          }
        });
      },

      { threshold: 0.14, rootMargin: "0px 0px -45px 0px" },
    );

    revealTargets.forEach((element) => revealObserver.observe(element));
  }
</script>

<script>
  (() => {
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!finePointer.matches || reducedMotion.matches) return;

    const cursor = document.createElement("div");

    cursor.className = "marginalia-cursor";

    cursor.setAttribute("aria-hidden", "true");

    cursor.innerHTML =
      '<span class="marginalia-cursor__dot"></span><span class="marginalia-cursor__ring"></span>';

    document.body.appendChild(cursor);

    document.documentElement.classList.add("has-marginalia-cursor");

    let x = window.innerWidth / 2;

    let y = window.innerHeight / 2;

    let ringX = x;

    let ringY = y;

    let frame = 0;

    const animateRing = () => {
      ringX += (x - ringX) * 0.18;

      ringY += (y - ringY) * 0.18;

      cursor.style.setProperty("--ring-x", `${ringX}px`);

      cursor.style.setProperty("--ring-y", `${ringY}px`);

      if (Math.abs(x - ringX) > 0.1 || Math.abs(y - ringY) > 0.1) {
        frame = window.requestAnimationFrame(animateRing);
      } else frame = 0;
    };

    document.addEventListener(
      "pointermove",

      (event: PointerEvent) => {
        x = event.clientX;

        y = event.clientY;

        cursor.classList.add("is-visible");

        cursor.style.setProperty("--cursor-x", `${x}px`);

        cursor.style.setProperty("--cursor-y", `${y}px`);

        if (!frame) frame = window.requestAnimationFrame(animateRing);
      },

      { passive: true },
    );

    document.addEventListener(
      "pointerover",

      (event: PointerEvent) => {
        const target = event.target instanceof Element ? event.target : null;

        const interactive = target?.closest(
          "a, button, input, textarea, select, [role='button']",
        );

        const textEntry = target?.closest(
          "input, textarea, [contenteditable='true']",
        );

        cursor.classList.toggle("is-interactive", Boolean(interactive));

        cursor.classList.toggle("is-text-entry", Boolean(textEntry));
      },

      { passive: true },
    );

    document.addEventListener("pointerout", (event: PointerEvent) => {
      if (!event.relatedTarget) cursor.classList.remove("is-visible");
    });

    document.addEventListener("pointerdown", () =>
      cursor.classList.add("is-pressed"),
    );

    document.addEventListener("pointerup", () =>
      cursor.classList.remove("is-pressed"),
    );

    window.addEventListener("blur", () =>
      cursor.classList.remove("is-visible"),
    );
  })();
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: auto;
  }

  :global(body) {
    margin: 0;

    color: #24221f;

    font-family: "DM Sans", sans-serif;

    -webkit-font-smoothing: antialiased;

    /* Clearly visible warm paper stock: mottling, fibres and fine printed-paper grain. */

    background-color: #f1e6d4;

    background-image:
      radial-gradient(
        ellipse at 12% 16%,

        rgba(132, 91, 52, 0.13),
        transparent 43%
      ),
      radial-gradient(
        ellipse at 86% 74%,

        rgba(157, 94, 57, 0.1),
        transparent 46%
      ),
      radial-gradient(
        ellipse at 50% 48%,

        rgba(255, 250, 239, 0.3),
        transparent 72%
      ),
      repeating-linear-gradient(
        2deg,
        rgba(112, 83, 54, 0.035) 0,

        rgba(112, 83, 54, 0.035) 1px,

        transparent 1px,

        transparent 5px
      ),
      url("data:image/svg+xml;base64,");

    background-repeat: no-repeat, no-repeat, no-repeat, repeat, repeat;

    background-size:
      auto,
      auto,
      auto,
      100% 100%,
      320px 320px;

    background-attachment: fixed;

    background-blend-mode: multiply, multiply, screen, multiply, multiply;
  }

  :global(a) {
    color: inherit;

    text-decoration: none;
  }

  :global(a:focus-visible) {
    outline: 2px solid #a64d36;

    outline-offset: 4px;
  }

  .page-shell {
    max-width: 1440px;

    margin: 0 auto;

    padding: 0 6.2%;
  }

  .site-header {
    min-height: 100px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 24px;

    border-bottom: 1px solid #ded8cc;
  }

  .wordmark,
  .footer-brand {
    font:
      400 21px "Libre Baskerville",
      Georgia,
      serif;
    letter-spacing: -1px;
  }

  .wordmark em,
  .footer-brand em {
    color: #a64d36;
  }

  /* Keep the navbar links separated and aligned on the right. */
  .site-header nav {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 30px;
    margin-left: auto;
    color: #756d62;
    font-size: 10px;
    letter-spacing: 1px;
  }

  .site-header nav a {
    display: inline-block;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current="page"] {
    color: #a64d36;
  }

  .eyebrow,
  .section-label {
    margin: 0;

    color: #a64d36;

    font-size: 9px;

    font-weight: 600;

    letter-spacing: 2px;

    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;

    align-items: center;

    gap: 11px;
  }

  .eyebrow span {
    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: #a64d36;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: "Libre Baskerville", Georgia, serif;

    font-weight: 400;
  }

  .editor-story {
    padding: 88px 5% 124px;
  }

  .section-label {
    margin: 0 0 44px;

    color: #a64d36;

    font-size: 9px;

    font-weight: 600;

    letter-spacing: 2px;

    text-transform: uppercase;
  }

  .story-grid {
    display: grid;

    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);

    gap: clamp(38px, 6vw, 92px);

    align-items: start;
  }

  .story-copy,
  .journal-copy {
    min-width: 0;

    max-width: 720px;
  }

  .journal-copy {
    padding-left: clamp(28px, 4vw, 58px);

    border-left: 1px solid rgba(130, 105, 77, 0.28);
  }

  .editor-story h2 {
    margin: 0 0 30px;

    font-size: clamp(34px, 4.1vw, 55px);

    line-height: 1.22;

    letter-spacing: -2px;
  }

  .editor-story h2 em,
  .journal-motto em {
    color: #a64d36;

    font-weight: 400;
  }

  .story-copy p,
  .journal-copy > p:not(.eyebrow):not(.journal-motto) {
    color: #5f594f;

    font:
      13px/2.1 "Libre Baskerville",
      Georgia,
      serif;
  }

  .story-copy p + p,
  .journal-copy > p + p {
    margin-top: 22px;
  }

  .journal-copy .eyebrow {
    margin: 5px 0 25px;
  }

  .journal-copy h2 {
    max-width: 520px;
  }

  .journal-motto {
    margin: 34px 0 0;

    padding-top: 22px;

    border-top: 1px solid rgba(130, 105, 77, 0.28);

    color: #756d62;

    font:
      italic 15px/1.8 "Libre Baskerville",
      Georgia,
      serif;
  }

  .site-footer {
    min-height: 95px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    border-top: 1px solid #dcd5c8;

    color: #857c70;

    font-size: 9px;
  }

  .footer-brand {
    color: #24221f;

    font-size: 16px;
  }

  /* CINEMATIC INTRO — matched to the homepage and essay pages */

  :global(html.intro-active),
  :global(html.intro-active body) {
    overflow: hidden;
  }

  .intro-curtain {
    position: fixed;

    inset: 0;

    z-index: 100000;

    display: grid;

    place-items: center;

    overflow: hidden;

    background: #211f1c;

    color: #f2eee5;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition:
      opacity 850ms cubic-bezier(0.76, 0, 0.24, 1),
      visibility 850ms;
  }

  .intro-curtain.intro-ready {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;
  }

  .intro-curtain::before,
  .intro-curtain::after {
    position: absolute;

    width: 70vmax;

    height: 70vmax;

    border: 1px solid rgba(196, 122, 96, 0.18);

    border-radius: 50%;

    content: "";

    transform: scale(0.3);

    opacity: 0;
  }

  .intro-curtain::before {
    animation: intro-ring 2.1s 0.05s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  .intro-curtain::after {
    width: 48vmax;

    height: 48vmax;

    animation: intro-ring 2.1s 0.18s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  .intro-curtain-inner {
    position: relative;

    z-index: 1;

    display: flex;

    flex-direction: column;

    align-items: center;

    padding: 30px;

    text-align: center;
  }

  .intro-overline,
  .intro-enter {
    color: #bdb3a5;

    font-size: 9px;

    letter-spacing: 3px;

    text-transform: uppercase;

    opacity: 0;
  }

  .intro-overline {
    animation: intro-rise 0.7s 0.15s ease forwards;
  }

  .intro-wordmark {
    margin: 24px 0 20px;

    font-family: "Libre Baskerville", Georgia, serif;

    font-size: clamp(45px, 9vw, 112px);

    letter-spacing: -0.075em;

    line-height: 1.15;

    clip-path: inset(0 50% 0 50%);

    animation: intro-unmask 1.05s 0.35s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  .intro-wordmark em {
    color: #c47a60;

    font-weight: 400;
  }

  .intro-rule {
    width: 0;

    height: 1px;

    background: #a96a53;

    animation: intro-rule 850ms 1s ease forwards;
  }

  .intro-enter {
    margin-top: 18px;

    animation: intro-rise 0.7s 1.25s ease forwards;
  }

  .intro-skip {
    position: absolute;

    right: 34px;

    bottom: 30px;

    z-index: 2;

    padding: 10px 0 10px 15px;

    border: 0;

    background: transparent;

    color: #c6bfb2;

    cursor: pointer;

    font-size: 9px;

    letter-spacing: 1.5px;

    text-transform: uppercase;
  }

  .intro-skip span {
    padding-left: 8px;

    color: #c47a60;
  }

  .intro-skip:hover {
    color: #fff;
  }

  .intro-curtain.intro-leaving {
    opacity: 0;

    visibility: hidden;

    pointer-events: none;
  }

  .intro-curtain.intro-leaving .intro-curtain-inner {
    transform: translateY(-35px) scale(0.96);

    opacity: 0;

    transition:
      transform 700ms cubic-bezier(0.76, 0, 0.24, 1),
      opacity 550ms;
  }

  @keyframes intro-ring {
    0% {
      transform: scale(0.3);

      opacity: 0;
    }

    35% {
      opacity: 1;
    }

    100% {
      transform: scale(1);

      opacity: 0;
    }
  }

  @keyframes intro-rise {
    from {
      opacity: 0;

      transform: translateY(12px);
    }

    to {
      opacity: 1;

      transform: translateY(0);
    }
  }

  @keyframes intro-unmask {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes intro-rule {
    to {
      width: min(260px, 55vw);
    }
  }

  /* Quiet editorial movement: reveal, stagger, and a little monogram response. */

  .will-reveal {
    opacity: 0;

    transform: translateY(28px);

    transition:
      opacity 850ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 850ms cubic-bezier(0.2, 0.7, 0.2, 1);

    transition-delay: var(--reveal-delay, 0ms);
  }

  .will-reveal.is-revealed {
    opacity: 1;

    transform: translateY(0);
  }

  :global(.marginalia-cursor) {
    position: fixed;

    inset: 0 auto auto 0;

    z-index: 99999;

    width: 0;

    height: 0;

    pointer-events: none;

    opacity: 0;

    transition: opacity 180ms ease;
  }

  :global(.marginalia-cursor.is-visible) {
    opacity: 1;
  }

  :global(.marginalia-cursor__dot) {
    position: absolute;

    left: var(--cursor-x, -100px);

    top: var(--cursor-y, -100px);

    width: 6px;

    height: 6px;

    border-radius: 50%;

    background: #a64d36;

    transform: translate(-50%, -50%);
  }

  :global(.marginalia-cursor__ring) {
    position: absolute;

    left: var(--ring-x, -100px);

    top: var(--ring-y, -100px);

    width: 31px;

    height: 31px;

    border: 1px solid rgba(166, 77, 54, 0.72);

    border-radius: 50%;

    transform: translate(-50%, -50%);

    transition:
      width 220ms ease,
      height 220ms ease,
      * * background * * 220ms ease;
  }

  :global(.marginalia-cursor.is-interactive .marginalia-cursor__ring) {
    width: 48px;

    height: 48px;

    background: rgba(166, 77, 54, 0.07);
  }

  :global(.marginalia-cursor.is-text-entry .marginalia-cursor__ring) {
    opacity: 0;
  }

  :global(.has-marginalia-cursor),
  :global(.has-marginalia-cursor body),
  :global(.has-marginalia-cursor a) {
    cursor: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .will-reveal {
      opacity: 1;

      transform: none;

      transition: none;
    }

    .intro-curtain {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .page-shell {
      padding: 0 22px;
    }

    .site-header {
      min-height: 76px;

      align-items: center;
    }

    .site-header nav {
      gap: 15px;

      font-size: 9px;
    }

    .editor-story {
      padding: 75px 0 85px;
    }

    .section-label {
      margin-bottom: 32px;
    }

    .story-grid {
      grid-template-columns: 1fr;

      gap: 48px;
    }

    .journal-copy {
      padding: 36px 0 0;

      border-left: 0;

      border-top: 1px solid rgba(130, 105, 77, 0.28);
    }

    .editor-story h2 {
      font-size: 39px;
    }

    .story-copy p,
    .journal-copy > p:not(.eyebrow):not(.journal-motto) {
      font-size: 12px;

      line-height: 2;
    }

    .site-footer {
      min-height: auto;

      flex-wrap: wrap;

      justify-content: space-between;

      padding: 25px 0;
    }

    .site-footer > span:nth-of-type(1) {
      order: 3;

      width: 100%;
    }
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    :global(.marginalia-cursor) {
      display: none !important;
    }

    :global(.has-marginalia-cursor),
    :global(.has-marginalia-cursor body),
    :global(.has-marginalia-cursor a) {
      cursor: auto !important;
    }
  }
</style>
