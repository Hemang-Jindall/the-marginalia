---
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
}

const { title, description, pubDate, category } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const homeUrl = base;
const archiveUrl = `${base}#archive`;

const currentPath = Astro.url.pathname;
const currentId = currentPath
  .replace(/^\/the-marginalia\/posts\//, "")
  .replace(/^\/posts\//, "")
  .replace(/\/$/, "");

const allPosts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = allPosts.findIndex(
  (post) => post.id === currentId || post.id.replace(/\.md$/, "") === currentId,
);

const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const olderPost =
  currentIndex >= 0 && currentIndex < allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : undefined;

const postUrl = (id: string) =>
  `${base.replace(/\/$/, "")}/posts/${id.replace(/\.md$/, "")}/`;

const readingTime = (body: string) =>
  Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 220));

const currentPost = currentIndex >= 0 ? allPosts[currentIndex] : undefined;
const minutes = currentPost ? readingTime(currentPost.body) : 1;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f5ed" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link
      rel="icon"
      href={`${base}favicon-32x32.png`}
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="apple-touch-icon"
      href={`${base}apple-touch-icon.png`}
    />

    <title>{title} — The Marginalia</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="reading-progress" aria-hidden="true">
      <div class="reading-progress-fill" id="reading-progress-fill"></div>
    </div>

    <div class="page">
      <div class="topline">
        <span>A personal literary journal</span>
        <span class="topline-center">Essays · Fiction · Reflections</span>
        <span>Established 2025</span>
      </div>

      <header>
        <a class="brand" href={homeUrl}>
          The <em>Marginalia.</em>
        </a>

        <nav aria-label="Main navigation">
          <a href={archiveUrl}>Writing</a>
          <a href={`${base}fiction/`}>Fiction</a>
          <a href={`${base}about/`}>About</a>
        </nav>
      </header>

      <main>
        <div class="article-navigation-top">
          <a class="back" href={archiveUrl}>
            <span aria-hidden="true">←</span>
            Back to the journal
          </a>

          <span class="issue-label">From the archive</span>
        </div>

        <article>
          <header class="article-header">
            <div class="category">{category}</div>

            <h1>{title}</h1>

            <p class="description">{description}</p>

            <div class="metadata">
              <time datetime={pubDate.toISOString()}>{formattedDate}</time>
              <span class="metadata-dot">·</span>
              <span>{minutes} min read</span>
              <span class="metadata-dot">·</span>
              <span>The Marginalia</span>
            </div>
          </header>

          <div class="article-body" id="article-body">
            <slot />
          </div>

          <div class="endmark" aria-label="End of article">* * *</div>

          <p class="endnote">
            Thank you for reading. Take the question with you.
          </p>

          <div class="author-colophon">
            <span class="colophon-rule" aria-hidden="true"></span>
            <span class="colophon-name">Hemang Jindal</span>
            <span class="colophon-note">Written for The Marginalia</span>
          </div>
        </article>

        <nav class="post-navigation" aria-label="More articles">
          <div class="post-navigation-heading">
            <span class="section-eyebrow">Continue reading</span>
            <span class="post-navigation-count">
              {currentIndex >= 0
                ? `${currentIndex + 1} of ${allPosts.length}`
                : "The journal"}
            </span>
          </div>

          <div class="post-navigation-grid">
            {
              olderPost ? (
                <a class="post-card previous" href={postUrl(olderPost.id)}>
                  <span class="post-direction">
                    <span aria-hidden="true">←</span> Older essay
                  </span>
                  <span class="post-card-title">{olderPost.data.title}</span>
                  <span class="post-card-category">
                    {olderPost.data.category}
                  </span>
                </a>
              ) : (
                <div class="post-card post-card-empty">
                  <span class="post-direction">Beginning of the journal</span>
                  <span class="post-card-title">
                    You've reached the earliest essay.
                  </span>
                </div>
              )
            }

            {
              newerPost ? (
                <a class="post-card next" href={postUrl(newerPost.id)}>
                  <span class="post-direction">
                    Newer essay <span aria-hidden="true">→</span>
                  </span>
                  <span class="post-card-title">{newerPost.data.title}</span>
                  <span class="post-card-category">
                    {newerPost.data.category}
                  </span>
                </a>
              ) : (
                <div class="post-card post-card-empty">
                  <span class="post-direction">Latest from the journal</span>
                  <span class="post-card-title">
                    You're all caught up.
                  </span>
                </div>
              )
            }
          </div>

          <a class="archive-link" href={archiveUrl}>
            Return to all writing <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </main>

      <footer>
        <a class="footer-brand" href={homeUrl}>
          The <em>Marginalia.</em>
        </a>

        <span>Written slowly, published occasionally.</span>

        <span>© {new Date().getFullYear()} Hemang Jindal</span>

        <a class="rss-link" href={`${base}rss.xml`} aria-label="RSS feed">
          RSS <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </div>
  </body>
</html>

<script>
  const progressBar = document.querySelector<HTMLElement>(
    "#reading-progress-fill",
  );
  const articleBody = document.querySelector<HTMLElement>("#article-body");

  let ticking = false;

  function updateReadingProgress() {
    if (!progressBar || !articleBody) return;

    const articleTop =
      articleBody.getBoundingClientRect().top + window.scrollY;
    const articleHeight = articleBody.offsetHeight;
    const readableHeight = articleHeight - window.innerHeight;

    if (readableHeight <= 0) {
      progressBar.style.width = "100%";
      ticking = false;
      return;
    }

    const distance = window.scrollY - articleTop;
    const progress = Math.min(100, Math.max(0, (distance / readableHeight) * 100));

    progressBar.style.width = `${progress}%`;
    ticking = false;
  }

  function requestProgressUpdate() {
    if (!ticking) {
      window.requestAnimationFrame(updateReadingProgress);
      ticking = true;
    }
  }

  window.addEventListener("scroll", requestProgressUpdate, { passive: true });
  window.addEventListener("resize", requestProgressUpdate);
  window.addEventListener("load", requestProgressUpdate);

  updateReadingProgress();
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 30px;
  }

  :global(body) {
    margin: 0;
    background: #f8f5ed;
    color: #24221f;
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(::selection) {
    background: #ead6ca;
    color: #24221f;
  }

  :global(a:focus-visible) {
    outline: 2px solid #a64d36;
    outline-offset: 4px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* READING PROGRESS */

  .reading-progress {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
  }

  .reading-progress-fill {
    width: 0;
    height: 100%;
    background: #a64d36;
    transition: width 80ms linear;
  }

  /* PAGE */

  .page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 54px;
  }

  .topline {
    min-height: 29px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    border-bottom: 1px dashed #bdb7aa;
    color: #81786c;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .topline-center {
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 10px;
    font-style: italic;
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
  }

  .topline > :last-child {
    text-align: right;
  }

  /* HEADER */

  .page > header {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px dashed #bdb7aa;
  }

  .brand {
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 22px;
    letter-spacing: -1.1px;
    white-space: nowrap;
  }

  .brand em,
  .footer-brand em {
    color: #a64d36;
    font-weight: 400;
  }

  .page > header nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 10px;
  }

  .page > header nav a {
    color: #625b51;
    transition: color 180ms ease;
  }

  .page > header nav a:hover {
    color: #a64d36;
  }

  /* ARTICLE TOP NAVIGATION */

  main {
    padding: 37px 0 80px;
  }

  .article-navigation-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #71695e;
    font-size: 11px;
    transition: color 180ms ease;
  }

  .back:hover {
    color: #a64d36;
  }

  .back span {
    font-size: 15px;
  }

  .issue-label {
    color: #8a8073;
    font-size: 8px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  /* ARTICLE HEADER */

  article {
    max-width: 680px;
    margin: 67px auto 0;
  }

  .article-header {
    padding-bottom: 28px;
    border-bottom: 1px solid #dcd6ca;
  }

  .category {
    color: #a64d36;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  h1 {
    margin: 21px 0 20px;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(37px, 5vw, 59px);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -2.5px;
    overflow-wrap: anywhere;
  }

  .description {
    margin: 0;
    color: #696258;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 15px;
    font-style: italic;
    line-height: 1.95;
  }

  .metadata {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
    color: #81786c;
    font-size: 9px;
    letter-spacing: 0.6px;
  }

  .metadata-dot {
    color: #a64d36;
  }

  /* ARTICLE BODY */

  .article-body {
    padding-top: 39px;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 16px;
    line-height: 2.05;
    overflow-wrap: anywhere;
    color: #302d28;
  }

  /* A restrained editorial drop cap: the first paragraph opens like a printed essay. */
  .article-body > :global(p:first-child)::first-letter {
    float: left;
    margin: 8px 9px 0 0;
    color: #a64d36;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 3.35em;
    line-height: 0.78;
  }

  .article-body :global(p) {
    margin: 0 0 27px;
  }

  .article-body :global(h2) {
    margin: 51px 0 21px;
    font-size: 27px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.8px;
  }

  .article-body :global(h3) {
    margin: 38px 0 17px;
    font-size: 21px;
    font-weight: 400;
    line-height: 1.6;
  }

  .article-body :global(h4) {
    margin: 30px 0 14px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.6;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 28px;
    padding-left: 27px;
  }

  .article-body :global(li) {
    margin-bottom: 9px;
    padding-left: 4px;
  }

  .article-body :global(blockquote) {
    position: relative;
    margin: 42px 0;
    padding: 5px 0 5px 27px;
    border-left: 2px solid #a64d36;
    color: #696258;
    font-style: italic;
  }

  .article-body :global(blockquote p) {
    font-size: 0.96em;
    line-height: 1.95;
  }

  .article-body :global(.footnotes) {
    margin-top: 58px;
    padding-top: 22px;
    border-top: 1px solid #dcd6ca;
    color: #71695e;
    font-family: "DM Sans", sans-serif;
    font-size: 12px;
    line-height: 1.8;
  }

  .article-body :global(.footnotes::before) {
    content: "NOTES";
    display: block;
    margin-bottom: 14px;
    color: #a64d36;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.8px;
  }

  .article-body :global(.footnotes p) {
    margin-bottom: 10px;
  }

  .article-body :global(sup) {
    color: #a64d36;
    font-family: "DM Sans", sans-serif;
    font-size: 0.7em;
  }

  .article-body :global(:target) {
    scroll-margin-top: 28px;
    background: rgba(166, 77, 54, 0.06);
  }

  .article-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-body :global(a) {
    color: #a64d36;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .article-body :global(a:hover) {
    color: #24221f;
  }

  .article-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 35px auto;
  }

  .article-body :global(hr) {
    width: 60px;
    margin: 45px auto;
    border: 0;
    border-top: 1px solid #bdb5a7;
  }

  .article-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 18px;
    border: 1px solid #ddd6c9;
    background: #f1ede3;
    font-family: monospace;
    font-size: 13px;
    line-height: 1.7;
  }

  .article-body :global(code) {
    font-family: monospace;
    font-size: 0.9em;
  }

  .article-body :global(table) {
    width: 100%;
    margin: 28px 0;
    border-collapse: collapse;
    font-family: "DM Sans", sans-serif;
    font-size: 12px;
    line-height: 1.7;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 10px;
    border: 1px solid #dcd6ca;
    text-align: left;
  }

  .article-body :global(th) {
    background: #f1ede3;
    font-weight: 600;
  }

  /* END OF ARTICLE */

  .endmark {
    margin: 48px 0 19px;
    color: #a64d36;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 14px;
    text-align: center;
    letter-spacing: 7px;
  }

  .endnote {
    margin: 0;
    color: #81786c;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 11px;
    font-style: italic;
    line-height: 1.8;
    text-align: center;
  }

  .author-colophon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    margin-top: 32px;
    text-align: center;
  }

  .colophon-rule {
    width: 28px;
    margin-bottom: 5px;
    border-top: 1px solid #bdb5a7;
  }

  .colophon-name {
    color: #4b453d;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 13px;
    font-style: italic;
  }

  .colophon-note {
    color: #9a9082;
    font-size: 8px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  /* PREVIOUS / NEXT */

  .post-navigation {
    max-width: 850px;
    margin: 78px auto 0;
    padding-top: 23px;
    border-top: 1px solid #4d473e;
  }

  .post-navigation-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 17px;
  }

  .section-eyebrow {
    color: #a64d36;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .post-navigation-count {
    color: #8a8073;
    font-size: 9px;
  }

  .post-navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .post-card {
    min-height: 145px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
    border: 1px solid #ded7ca;
    transition:
      border-color 180ms ease,
      background 180ms ease;
  }

  .post-card:hover {
    border-color: #a64d36;
    background: #f4efe5;
  }

  .post-direction {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #a64d36;
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .post-card-title {
    margin: 13px 0 10px;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 16px;
    line-height: 1.6;
  }

  .post-card-category {
    margin-top: auto;
    color: #8a8073;
    font-size: 8px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .post-card-empty {
    border-style: dashed;
  }

  .archive-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
    color: #71695e;
    font-size: 10px;
    transition: color 180ms ease;
  }

  .archive-link:hover {
    color: #a64d36;
  }

  /* FOOTER */

  footer {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    border-top: 1px solid #dcd6ca;
    color: #81786c;
    font-size: 9px;
  }

  .footer-brand {
    color: #24221f;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: 16px;
    letter-spacing: -0.4px;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #a64d36;
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .rss-link:hover {
    color: #24221f;
  }

  /* TABLET */

  @media (max-width: 800px) {
    .page {
      padding: 0 30px;
    }

    article {
      margin-top: 55px;
    }

    .post-navigation {
      margin-top: 60px;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .page {
      padding: 0 21px;
    }

    .topline {
      min-height: 27px;
      font-size: 7px;
      letter-spacing: 0.8px;
    }

    .topline-center {
      font-size: 8px;
    }

    .page > header {
      min-height: 69px;
      gap: 12px;
    }

    .brand {
      font-size: 17px;
      letter-spacing: -0.8px;
    }

    .page > header nav {
      gap: 12px;
      font-size: 9px;
    }

    main {
      padding: 27px 0 55px;
    }

    .back {
      font-size: 10px;
    }

    .issue-label {
      font-size: 7px;
      letter-spacing: 1px;
    }

    article {
      margin-top: 45px;
    }

    .category {
      font-size: 8px;
      letter-spacing: 1.6px;
    }

    h1 {
      margin: 17px 0;
      font-size: clamp(34px, 9vw, 47px);
      line-height: 1.27;
      letter-spacing: -1.8px;
    }

    .description {
      font-size: 12px;
      line-height: 1.9;
    }

    .metadata {
      gap: 8px;
      margin-top: 21px;
      font-size: 8px;
      line-height: 1.8;
    }

    .article-header {
      padding-bottom: 23px;
    }

    .article-body {
      padding-top: 29px;
      font-size: 14px;
      line-height: 1.98;
    }

    .article-body > :global(p:first-child)::first-letter {
      margin: 6px 7px 0 0;
      font-size: 3em;
    }

    .article-body :global(p) {
      margin-bottom: 23px;
    }

    .article-body :global(h2) {
      margin: 39px 0 16px;
      font-size: 23px;
      line-height: 1.5;
    }

    .article-body :global(h3) {
      margin: 31px 0 14px;
      font-size: 19px;
    }

    .article-body :global(h4) {
      font-size: 16px;
    }

    .article-body :global(blockquote) {
      margin: 28px 0;
      padding-left: 17px;
    }

    .article-body :global(ul),
    .article-body :global(ol) {
      padding-left: 22px;
    }

    .article-body :global(table) {
      display: block;
      overflow-x: auto;
    }

    .endmark {
